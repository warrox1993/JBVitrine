{
  "name": "my-next-app",
  "version": "0.1.2",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 --turbopack",
    "dev:webpack": "next dev -p 3000 --webpack",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "postbuild": "next-sitemap",
    "start": "next start",
    "lint": "eslint . --max-warnings=100",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "perf:build": "next build",
    "perf:start": "next start",
    "perf:lh:desktop": "npx lighthouse http://localhost:3000/ --output html --output json --output-path reports/performance/lh-desktop --chrome-flags=\"--headless=new\" --throttling-method=devtools --form-factor=desktop --screenEmulation.mobile=false",
    "perf:lh:mobile": "npx lighthouse http://localhost:3000/ --output html --output json --output-path reports/performance/lh-mobile --chrome-flags=\"--headless=new\" --throttling-method=devtools --form-factor=mobile --screenEmulation.mobile=true",
    "open": "powershell -NoProfile -Command \"start '' 'http://localhost:3000/'\"",
    "perf:all": "npm run perf:build && start cmd /c \"npm run perf:start\" && timeout 5 && npm run perf:lh:desktop && npm run perf:lh:mobile",
    "prepare": "husky"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "libphonenumber-js": "^1.13.9",
    "lucide-react": "^1.27.0",
    "marked": "^18.0.7",
    "next": "^16.2.12",
    "next-auth": "^4.24.15",
    "next-intl": "^4.13.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-toastify": "^11.1.0",
    "resend": "^6.18.0",
    "sanitize-html": "^2.17.6",
    "undici": "^8.9.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.12",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "autoprefixer": "^10.5.4",
    "baseline-browser-mapping": "^2.11.4",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "next-sitemap": "^4.2.3",
    "pg": "^8.22.0",
    "postcss-import": "^16.1.1",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "postcss": "^8.5.23",
    "sharp": "^0.35.3",
    "@eslint/config-array": "^0.23.5",
    "minimatch@10": {
      "brace-expansion": "^5.0.8"
    },
    "minimatch": "^10.2.5"
  }
}
