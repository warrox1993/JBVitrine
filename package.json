{
  "name": "my-next-app",
  "version": "0.1.2",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 --turbopack",
    "build": "next build",
    "postbuild": "next-sitemap",
    "start": "next start",
    "lint": "eslint . --max-warnings=100",
    "typecheck": "tsc --noEmit",
    "perf:build": "next build",
    "perf:start": "next start",
    "perf:lh:desktop": "npx lighthouse http://localhost:3000/ --output html --output json --output-path reports/performance/lh-desktop --chrome-flags=\"--headless=new\" --throttling-method=devtools --form-factor=desktop --screenEmulation.mobile=false",
    "perf:lh:mobile": "npx lighthouse http://localhost:3000/ --output html --output json --output-path reports/performance/lh-mobile --chrome-flags=\"--headless=new\" --throttling-method=devtools --form-factor=mobile --screenEmulation.mobile=true",
    "open": "powershell -NoProfile -Command \"start '' 'http://localhost:3000/'\"",
    "perf:all": "npm run perf:build && start cmd /c \"npm run perf:start\" && timeout 5 && npm run perf:lh:desktop && npm run perf:lh:mobile",
    "prepare": "husky"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@upstash/ratelimit": "^2.0.7",
    "@upstash/redis": "^1.35.6",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "bcryptjs": "^3.0.3",
    "libphonenumber-js": "^1.12.25",
    "lucide-react": "^0.552.0",
    "marked": "^17.0.1",
    "next": "^16.2.10",
    "next-auth": "^4.24.13",
    "next-intl": "^4.13.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-phone-number-input": "^3.4.13",
    "react-toastify": "^11.0.2",
    "resend": "^6.4.0",
    "sanitize-html": "^2.17.5",
    "undici": "^8.7.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@fullhuman/postcss-purgecss": "^7.0.2",
    "@next/bundle-analyzer": "^16.0.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^25.0.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/sanitize-html": "^2.16.1",
    "autoprefixer": "^10.4.22",
    "baseline-browser-mapping": "^2.9.12",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "husky": "^9.1.7",
    "next-sitemap": "^4.2.3",
    "pg": "^8.16.3",
    "postcss-import": "^16.1.1",
    "sharp": "^0.34.4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "overrides": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2"
  }
}
