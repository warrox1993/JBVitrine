# ─── Base de données (Neon Postgres) ──────────────────────────────
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# POSTGRES_URL=            # fallback Vercel/Neon (optionnel)

# ─── Redis (Upstash) — rate limiting, CSRF, cache ─────────────────
# Le code accepte aussi les noms de l'intégration Vercel Marketplace
# (KV_REST_API_URL / KV_REST_API_TOKEN). Si AUCUNE des deux paires n'est
# définie, le rate limiting et le store CSRF ne fonctionnent pas.
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ─── Authentification (NextAuth) ──────────────────────────────────
NEXTAUTH_SECRET=            # openssl rand -base64 32
NEXTAUTH_URL=https://smidjan.be
ADMIN_SECRET=              # protège /api/admin/reset-rate-limit
CRON_SECRET=               # protège les crons digest + cleanup (obligatoire)
ADMIN_INITIAL_PASSWORD=    # optionnel : sinon mot de passe aléatoire au seed

# ─── reCAPTCHA Enterprise (Google) ────────────────────────────────
NEXT_PUBLIC_RECAPTCHA_SITE_ID=
RECAPTCHA_PROJECT_ID=
RECAPTCHA_ENTERPRISE_API_KEY=
SKIP_RECAPTCHA=false       # ne JAMAIS mettre true en prod
# Hôtes autorisés à générer un token reCAPTCHA (séparés par des virgules).
# Par défaut : le domaine canonique de src/config/site.ts + VERCEL_URL.
# La clé publique étant publique, sans ce contrôle un token forgé sur le site
# d'un attaquant serait accepté.
RECAPTCHA_ALLOWED_HOSTNAMES=

# ─── Email transactionnel (Resend) ────────────────────────────────
RESEND_API_KEY=
NOTIFICATIONS_EMAIL=       # destinataire des notifs serveur (défaut en dur sinon)

# ─── Vie privée / RGPD ────────────────────────────────────────────
# Poivre du hachage des IP dans les clés Redis de sécurité.
# À défaut, NEXTAUTH_SECRET est utilisé. Ne PAS changer sans raison :
# cela repart de zéro pour les compteurs de violations par IP.
IP_HASH_PEPPER=
# Durées de conservation en mois, appliquées par le cron
# /api/admin/leads/cleanup (voir vercel.json).
RETENTION_LEADS_MONTHS=24
RETENTION_SESSIONS_MONTHS=6
RETENTION_EVENTS_MONTHS=3

# ─── Enrichissement de leads (optionnel) ──────────────────────────
HUNTER_API_KEY=
BRANDFETCH_API_KEY=
OPENAI_API_KEY=
CBEAPI_SECRET=

# ─── Notifications (optionnel) ────────────────────────────────────
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# ─── Divers ───────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://smidjan.be
SITE_URL=https://smidjan.be   # utilisé par next-sitemap
